Options -Indexes
DirectoryIndex index.php index.html
AddType image/webp .webp
AddType image/avif .avif
<IfModule mod_setenvif.c>
    # Thumbnail publik: cache 7 hari, revalidasi murah. Gambar profil
    # diatur oleh profile/.htaccess; cover books tetap private (perlu login).
    SetEnvIf Request_URI "^/(?:.*/)?(?:video|music|books)/upload/thumbnail/" MEEL_MEDIA_THUMB=1
    SetEnvIf Request_URI "^/(?:.*/)?(?:video|music)/upload/thumbnail/" MEEL_MEDIA_PUBLIC_CACHE=1
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cache-Control "public, max-age=604800, stale-while-revalidate=86400" env=MEEL_MEDIA_PUBLIC_CACHE
    # Sebagian .htaccess storage lama memakai ForceType inherit yang membuat
    # Content-Type literal "inherit"; paksa MIME yang benar untuk thumbnail.
    <FilesMatch "\.webp$">
        Header always set Content-Type "image/webp" env=MEEL_MEDIA_THUMB
    </FilesMatch>
    <FilesMatch "\.avif$">
        Header always set Content-Type "image/avif" env=MEEL_MEDIA_THUMB
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg)$">
        Header always set Content-Type "image/jpeg" env=MEEL_MEDIA_THUMB
    </FilesMatch>
    <FilesMatch "\.png$">
        Header always set Content-Type "image/png" env=MEEL_MEDIA_THUMB
    </FilesMatch>
    <FilesMatch "\.gif$">
        Header always set Content-Type "image/gif" env=MEEL_MEDIA_THUMB
    </FilesMatch>
</IfModule>
<FilesMatch "(\.env|\.git|\.htaccess|\.htpasswd|\.sql|\.log|config\.php|settings\.php|settings\.example\.php|cookies\.txt|auth\.php|sitemap\.php|robots\.php|phpunit\.xml|\.vscode|composer\.(json|lock)|package(-lock)?\.json|install\.sh|docker-compose\.ya?ml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "(~|\.bak$|\.old$|\.orig$|\.swp$|\.dist$|\.sample$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 403 "(^|/)(vendor|node_modules)/"
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(vscode|idea|git|freebuff)(/|$)" - [F,L]
    RewriteRule ^(vendor|node_modules)/ - [F,L]
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE text/vtt
</IfModule>
<IfModule mod_rewrite.c>
    RewriteRule ^arcade/testgeneric\.php$ - [E=ROOTPROC:1]
    RewriteEngine On
    RewriteRule ^sw\.js$ sw.js.php [END]
    RewriteRule ^assets/manifest\.json$ manifest.php [END]
</IfModule>
<IfModule mod_rewrite.c>
    # Thumbnail publik: layani langsung oleh Apache bila file tersedia
    # (symlink storage → HDD). Kalau tidak ada, fallback ke handler PHP.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(video|music)/upload/thumbnail/.+\.(webp|jpe?g|png|gif|avif)$ - [END,NC]
    RewriteRule ^video/upload/(.+)$ video/stream.php?f=$1 [END,QSA,B]
    RewriteRule ^music/upload/(.+)$ music/file.php?f=$1 [END,QSA,B]
    RewriteRule ^books/upload/(.+)$ books/file.php?f=$1 [END,QSA,B]
</IfModule>
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^(.*)/(video|music|books|drive|admin|arcade)/index\.php$ [NC]
    RewriteRule ^ %1/%2/beranda [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/err/index\.php$ [NC]
    RewriteRule ^ %1/err/ [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/index\.php$ [NC]
    RewriteRule ^ %1/ [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/upload_advanced\.php$ [NC]
    RewriteRule ^ %1/upload [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/upload-advanced([?#]?)$ [NC]
    RewriteRule ^ %1/upload [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/video/search_video\.php$ [NC]
    RewriteRule ^ %1/video/search [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/video/load_more\.php$ [NC]
    RewriteRule ^ %1/video/load-more [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/music/search_music\.php$ [NC]
    RewriteRule ^ %1/music/search [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/music/load_more_music\.php$ [NC]
    RewriteRule ^ %1/music/load-more [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/music/view_playlist\.php$ [NC]
    RewriteRule ^ %1/music/playlist [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/music/playlist_action\.php$ [NC]
    RewriteRule ^ %1/music/playlist-action [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/books/search_books\.php$ [NC]
    RewriteRule ^ %1/books/search [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/admin/activity_log\.php$ [NC]
    RewriteRule ^ %1/admin/activity-log [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/admin/mfa_reset\.php$ [NC]
    RewriteRule ^ %1/admin/mfa-reset [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/auth/mfa_setup\.php$ [NC]
    RewriteRule ^ %1/auth/mfa-setup [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/auth/mfa_verify\.php$ [NC]
    RewriteRule ^ %1/auth/mfa-verify [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/admin/analys([?#]?)$ [NC]
    RewriteRule ^ %1/admin/stats.php [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/admin/cookies\.php$ [NC]
    RewriteRule ^ %1/admin/stats.php [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/admin/cookies([?#]?)$ [NC]
    RewriteRule ^ %1/admin/stats.php [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/admin/content\.php$ [NC]
    RewriteRule ^ %1/admin/stats.php [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/admin/content([?#]?)$ [NC]
    RewriteRule ^ %1/admin/stats.php [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/api/delete_comment\.php$ [NC]
    RewriteRule ^ %1/api/delete-comment [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/api/auto_metadata\.php$ [NC]
    RewriteRule ^ %1/api/auto-metadata [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/api/download_transcode\.php$ [NC]
    RewriteRule ^ %1/api/download-transcode [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/api/post_encode\.php$ [NC]
    RewriteRule ^ %1/api/post-encode [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/api/ajax_refresh\.php$ [NC]
    RewriteRule ^ %1/api/ajax-refresh [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/api/server_stats\.php$ [NC]
    RewriteRule ^ %1/api/server-stats [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/api/server_stats_sse\.php$ [NC]
    RewriteRule ^ %1/api/server-stats-sse [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/api/upload_heartbeat\.php$ [NC]
    RewriteRule ^ %1/api/upload-heartbeat [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/api/(like|comment|pdf)\.php$ [NC]
    RewriteRule ^ %1/api/%2 [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/system/mfa\.php$ [NC]
    RewriteRule ^ %1/system/mfa [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/profile/profile_edit\.php$ [NC]
    RewriteRule ^ %1/profile/edit [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/profile/fun-manage\.php$ [NC]
    RewriteRule ^ %1/profile/manage [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/admin/admin_actions\.php$ [NC]
    RewriteRule ^ %1/admin [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/controllers/admin/admin_data\.php$ [NC]
    RewriteRule ^ %1/admin [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} !(^|/)arcade/chess/
    RewriteCond %{REQUEST_URI} ^(.*)/([a-z0-9_-]+)\.php$ [NC]
    RewriteRule ^ %1/%2 [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/(video|music|books|drive|admin|arcade)/?([?#]?)$ [NC]
    RewriteRule ^ %1/%2/beranda [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/profile([?#]?)$ [NC]
    RewriteRule ^ %1/profile/ [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/err([?#]?)$ [NC]
    RewriteRule ^ %1/err/ [R=301,L,QSA]
    RewriteCond %{REQUEST_URI} ^(.*)/(video|music|books|drive)/upload/$ [NC]
    RewriteRule ^ %1/%2/upload [R=301,L,QSA]
    RewriteRule ^video/upload/?$ router.php [END,QSA]
    RewriteRule ^music/upload/?$ router.php [END,QSA]
    RewriteRule ^books/upload/?$ router.php [END,QSA]
    RewriteRule ^drive/upload/?$ router.php [END,QSA]
    RewriteRule ^profile/?$ router.php [END,QSA]
    RewriteRule ^err/?$ router.php [END,QSA]
    RewriteRule ^arcade/chess/?$ router.php [END,QSA]
    RewriteRule ^$ router.php [END]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ router.php [END,QSA]
</IfModule>
