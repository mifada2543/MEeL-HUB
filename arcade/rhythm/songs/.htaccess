<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php3|php4|php5|phtml|phps|pl|py|jsp|asp|sh|cgi|bat|cmd)$">
SetHandler default-handler
RemoveHandler .php .php3 .php4 .php5 .phtml .pl .py .jsp .asp .sh .cgi
RemoveType .php .php3 .php4 .php5 .phtml .pl .py .jsp .asp .sh .cgi
</FilesMatch>

<FilesMatch "(?i)^(?!(?:.+\.)(?:json|svg|jpg|jpeg|png|gif|webp|mp3|ogg|opus|flac|wav|m4a)(?:$)).+$">
ForceType application/octet-stream
</FilesMatch>

<FilesMatch "(?i)\.(php|phtml|pl|py|sh|cgi|exe|bat|cmd|html|htm|js|xml|xsl|xhtml|swf)$">
ForceType text/plain
</FilesMatch>

AddType application/json .json
AddType image/webp .webp
AddType audio/ogg .ogg
AddType audio/ogg .opus
AddType audio/flac .flac
AddType audio/mp4 .m4a

Options -Indexes
