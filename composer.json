{
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "test": [
      "@test:unit",
      "@test:security",
      "@test:functional"
    ],
    "test:all": [
      "@test",
      "@test:integration"
    ],
    "test:unit": "phpunit --no-coverage --testsuite='MEeL Core Unit Tests'",
    "test:integration": "phpunit --no-coverage --testsuite='MEeL Integration Tests'",
    "test:security": "php tests/security_test.php",
    "test:functional": "php tests/functional_test.php",
    "test:deploy": "php tools/check_deploy.php",
    "test:migration": "php scripts/ci/schema-parity-check.php",
    "test:tailwind": "php scripts/ci/tailwind-coverage-check.php --rebuild",
    "build:css": "php scripts/build-css-bundle.php",
    "lint:shell": "shellcheck -S warning $(find . -name '*.sh' -not -path './vendor/*' -not -path './node_modules/*' -not -path './.git/*' | sort)"
  },
  "__meel_marker": "reference build: MEeL-C10H12N2O [b5d0ee8c97c7abd7]"
}
