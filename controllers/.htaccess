# Security defaults for controllers
# Direct access blocked — controllers are include-only (routed via .htaccess root)
#
# `Deny from all` polos harus dibungkus: di Apache 2.4 tanpa
# mod_access_compat, direktif 2.2 itu error config sehingga SELURUH
# .htaccess ini dibuang — dan controllers/ kehilangan seluruh kontrol akses.
Options -Indexes

<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^(.*/)[^/]+/?$
    RewriteRule ^ - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
