# Dependency Composer — hanya untuk include PHP, bukan untuk diakses lewat web.
# Tanpa ini, /vendor/phpunit/phpunit/composer.json dan daftar versi dependency
# lain bisa diunduh tanpa autentikasi.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^(.*/)[^/]+/?$
    RewriteRule ^ - [F,L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>
