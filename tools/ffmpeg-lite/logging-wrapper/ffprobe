#!/usr/bin/env bash
# Mencatat setiap panggilan lalu meneruskan ke biner lite di folder induk.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Logging best-effort: jangan pernah gagalkan ffprobe karena log tidak bisa ditulis.
( echo "$(date +%T) ffprobe $*" >> "${MEEL_FF_LOG:-/tmp/meel-ff.log}" ) 2>/dev/null || true
exec "$DIR/ffprobe" "$@"
